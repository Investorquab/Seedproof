import { chromium } from "playwright";
import { readFileSync } from "node:fs";
import { pqcKeyFromRecoveryCode, deriveUnifiedAccount } from "@qorechain/sdk";
import { FrameCollector, encodeFrames, signVaultRequest, describeVaultRequest, isVaultRequest } from "../../packages/core/src/index.ts";
const K = "/home/claude/seedproof-keys";
const m = JSON.parse(readFileSync(`${K}/accounts.json`, "utf8")).pocket.mnemonic;
const acct: any = await deriveUnifiedAccount(m);
const home = pqcKeyFromRecoveryCode(readFileSync(`${K}/pocket-homekey.txt`, "utf8").trim(), acct.cosmos);

const b = await chromium.launch({ executablePath: "/usr/bin/google-chrome" });
const ctx = await b.newContext({ viewport: { width: 390, height: 844 }, permissions: ["clipboard-read", "clipboard-write"] });
const p = await ctx.newPage();
const errs: string[] = []; p.on("pageerror", (e) => errs.push(e.message));
await p.goto("http://localhost:4173/pocket");
await p.fill("#words", m); await p.fill("#pp", "correct horse battery");
await p.click("button[type=submit]");
await p.waitForSelector("text=Open vault", { timeout: 60000 });
await p.waitForTimeout(1500);
console.log("teaser:", (await p.textContent(".vault-teaser"))?.replace(/\s+/g, " "));
await p.click("text=Open vault");
await p.waitForSelector(".vault-card", { timeout: 30000 });
await p.waitForTimeout(4000);
await p.screenshot({ path: "/home/claude/out/vault-screen.png", fullPage: true });
console.log("vault card:", (await p.textContent(".vault-card"))?.replace(/\s+/g, " ").slice(0, 300));
console.log("waiting:", (await p.textContent("section[aria-labelledby=waiting]").catch(() => "none"))?.replace(/\s+/g, " ").slice(0, 200));
await p.click("text=Top up now");
await p.fill("#vamt", "5");
await p.click("text=Ask Home Key");
await p.waitForSelector("text=Copy as text instead", { timeout: 30000 });
console.log("ask line:", await p.textContent(".pocket-ask-line"));
await p.click("text=Copy as text instead");
const text: string = await p.evaluate(() => navigator.clipboard.readText());
const col = new FrameCollector(); let req: any;
for (const line of text.split("\n")) { const r: any = col.add(line); if (r.status === "complete") req = r.message; }
console.log("home key reads:", isVaultRequest(req), describeVaultRequest(req).lines.map((l) => l.text));
const res = signVaultRequest(req, home);
await p.click("text=Scan the Home Key's answer");
await p.click("text=Paste text");
await p.fill("#frames", encodeFrames(res).join("\n"));
await p.click("text=Read frames");
await p.waitForSelector(".notice-good, .notice-bad", { timeout: 120000 });
console.log("result:", (await p.textContent(".notice-good, .notice-bad"))?.replace(/\s+/g, " "));
console.log("explorer:", await p.getAttribute("a[href*='/tx/']", "href").catch(() => null));
await p.screenshot({ path: "/home/claude/out/vault-done.png", fullPage: true });
console.log("errors:", errs); await b.close();
